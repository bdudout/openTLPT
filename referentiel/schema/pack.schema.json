{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentlpt.eu/schema/pack.schema.json",
  "title": "openTLPT referential pack",
  "type": "object",
  "required": ["pack_id", "framework", "version", "title", "sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "framework": { "$ref": "#/$defs/frameworkAny" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "$ref": "#/$defs/LocalizedText" },
    "license_note": { "$ref": "#/$defs/LocalizedText" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Source" } },
    "profiles":     { "type": "array", "items": { "$ref": "#/$defs/Profile" } },
    "actors":       { "type": "array", "items": { "$ref": "#/$defs/Actor" } },
    "phases":       { "type": "array", "items": { "$ref": "#/$defs/Phase" } },
    "themes":       { "type": "array", "items": { "$ref": "#/$defs/Theme" } },
    "events":       { "type": "array", "items": { "$ref": "#/$defs/Event" } },
    "facts":        { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
    "deliverables": { "type": "array", "items": { "$ref": "#/$defs/Deliverable" } },
    "deadlines":    { "type": "array", "items": { "$ref": "#/$defs/Deadline" } },
    "items":        { "type": "array", "items": { "$ref": "#/$defs/Item" } },
    "notes":        { "type": "array", "items": { "$ref": "#/$defs/Note" } }
  },

  "$defs": {
    "frameworkAny": {
      "anyOf": [
        { "enum": ["core", "DORA", "RTS_TLPT", "DORA+RTS_TLPT", "TIBER-EU"] },
        { "type": "string", "pattern": "^TIBER-[A-Z]{2}$" }
      ]
    },
    "Id": { "type": "string", "pattern": "^[A-Za-z0-9_.\\-]+$" },
    "LangCode": { "type": "string", "pattern": "^(bg|cs|da|de|el|en|es|et|fi|fr|ga|hr|hu|it|lt|lv|mt|nl|pl|pt|ro|sk|sl|sv)$" },
    "LocalizedText": {
      "type": "object",
      "required": ["fr", "en"],
      "propertyNames": { "$ref": "#/$defs/LangCode" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "Source": {
      "type": "object",
      "required": ["id", "title", "url", "checked_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "title": { "type": "string" },
        "version": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "url": { "type": "string", "format": "uri" },
        "eli": { "type": "string", "format": "uri" },
        "celex": { "type": "string" },
        "checked_at": { "type": "string", "format": "date" }
      }
    },
    "Profile": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "includes": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "description": "Union of other profiles (e.g. ti_rt = ti + rt)" },
        "description": { "$ref": "#/$defs/LocalizedText" }
      }
    },
    "Actor": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "external": { "type": "boolean", "description": "true = external stakeholder followed, not a user of the file" },
        "source": { "$ref": "#/$defs/Id" }
      }
    },
    "Phase": {
      "type": "object",
      "required": ["id", "order", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "order": { "type": "integer", "minimum": 0 },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "starts_at": { "$ref": "#/$defs/Id" },
        "ends_at": { "$ref": "#/$defs/Id" }
      }
    },
    "Theme": {
      "type": "object",
      "required": ["id", "order", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "order": { "type": "integer", "minimum": 0 },
        "label": { "$ref": "#/$defs/LocalizedText" }
      }
    },
    "Event": {
      "type": "object",
      "required": ["id", "label", "phase", "set_by"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "phase": { "$ref": "#/$defs/Id" },
        "set_by": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "description": "Actors whose action produces the event" },
        "after": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "description": "Events that must precede it (consistency check)" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/Id" } }
      }
    },
    "Fact": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "enum": ["boolean", "enum", "integer"] },
        "values": { "type": "array", "items": { "type": "string" } },
        "default": {},
        "label": { "$ref": "#/$defs/LocalizedText" },
        "help": { "$ref": "#/$defs/LocalizedText" }
      }
    },
    "Deliverable": {
      "type": "object",
      "required": ["id", "label", "phase", "producers"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^DLV-[A-Z0-9-]+$" },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "phase": { "$ref": "#/$defs/Id" },
        "producers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } },
        "recipients": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "approved_by": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "annex": { "type": "string", "description": "RTS annex defining minimum content" },
        "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } },
        "sensitive": { "type": "boolean" },
        "applies_when": { "$ref": "#/$defs/Condition" }
      }
    },
    "Offset": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "unit": { "enum": ["days", "weeks", "months", "working_days", "years"] }
      }
    },
    "Deadline": {
      "type": "object",
      "required": ["id", "anchor", "kind", "carriers", "sources", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^D-[0-9]{2}$" },
        "anchor": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["max", "min", "before", "recurring"] },
        "offset": { "$ref": "#/$defs/Offset" },
        "every": { "$ref": "#/$defs/Offset" },
        "until": { "$ref": "#/$defs/Id" },
        "end_event": { "$ref": "#/$defs/Id", "description": "For kind=min: event checked against anchor+offset" },
        "carriers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deliverable": { "$ref": "#/$defs/Id" },
            "milestone": { "$ref": "#/$defs/LocalizedText" }
          }
        },
        "overridable": { "type": "boolean", "default": false },
        "display": { "enum": ["check", "info"], "default": "check" },
        "applies_when": { "$ref": "#/$defs/Condition" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "note": { "$ref": "#/$defs/LocalizedText" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["max", "min"] } } }, "then": { "required": ["offset"] } },
        { "if": { "properties": { "kind": { "const": "min" } } }, "then": { "required": ["end_event"] } },
        { "if": { "properties": { "kind": { "const": "recurring" } } }, "then": { "required": ["every", "until"] } }
      ]
    },
    "FactTest": {
      "type": "object",
      "required": ["fact"],
      "additionalProperties": false,
      "properties": {
        "fact": { "$ref": "#/$defs/Id" },
        "eq": {},
        "in": { "type": "array" }
      },
      "oneOf": [ { "required": ["eq"] }, { "required": ["in"] } ]
    },
    "Condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FactTest" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FactTest" } }
      }
    },
    "LegalRef": {
      "type": "object",
      "required": ["instrument", "article"],
      "additionalProperties": false,
      "properties": {
        "instrument": { "enum": ["DORA", "RTS_2025_1190", "TIBER-EU_2025", "TIBER-FR_V2"] },
        "article": { "type": "string" },
        "paragraph": { "type": "string" },
        "subparagraph": { "type": "string" },
        "point": { "type": "string" },
        "section": { "type": "string", "description": "Section/chapter for non-legal sources" },
        "eli": { "type": "string", "format": "uri" }
      }
    },
    "Relation": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["adds", "restates", "diverges"] },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "note": { "$ref": "#/$defs/LocalizedText" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "restates" } } }, "then": { "required": ["targets"] } },
        { "if": { "properties": { "type": { "const": "diverges" } } }, "then": { "required": ["targets", "note"] } }
      ]
    },
    "Item": {
      "type": "object",
      "required": ["id", "nature", "source", "phase", "carriers", "profiles", "title", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "nature": { "enum": ["obligation", "good_practice", "national_obligation"] },
        "scope": {
          "enum": ["standing", "stepwise"],
          "description": "Obligations only. standing = permanent compliance point (applies to the whole exercise); stepwise = point to secure as the test progresses (dated step or validation)."
        },
        "theme": { "$ref": "#/$defs/Id", "description": "Standing obligations only: theme id from core.themes." },
        "matrix_ref": { "type": "string" },
        "source": { "$ref": "#/$defs/LegalRef" },
        "phase": { "$ref": "#/$defs/Id" },
        "carriers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } },
        "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } },
        "display": { "enum": ["check", "info"], "default": "check" },
        "applies_when": { "$ref": "#/$defs/Condition" },
        "deliverables": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "deadlines": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "title": { "$ref": "#/$defs/LocalizedText" },
        "summary": { "$ref": "#/$defs/LocalizedText" },
        "question": { "$ref": "#/$defs/LocalizedText" },
        "evidence": { "$ref": "#/$defs/LocalizedText" },
        "relation": { "$ref": "#/$defs/Relation" },
        "replaced_by": { "$ref": "#/$defs/Id" }
      },
      "allOf": [
        {
          "if": { "properties": { "nature": { "enum": ["good_practice", "national_obligation"] } } },
          "then": { "required": ["relation", "question"] }
        },
        {
          "if": { "properties": { "nature": { "const": "obligation" } } },
          "then": { "required": ["scope"], "not": { "required": ["relation"] } }
        }
      ]
    },
    "Note": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "text": { "$ref": "#/$defs/LocalizedText" }
      }
    }
  }
}
